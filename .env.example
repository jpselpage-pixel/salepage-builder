# ============ การตั้งค่าเซิร์ฟเวอร์ ============
PORT=3000
# ใช้ secret ยาว ๆ แบบสุ่มในการเซ็น/สร้างข้อมูลที่อ่อนไหว
SESSION_SECRET=please-change-this-to-a-long-random-string
# อายุ session (วัน) ก่อนต้องล็อกอินใหม่
SESSION_TTL_DAYS=7

# ============ โหมดพัฒนา (DEV) ============
# true  = โหมดจำลอง: OTP และลิงก์ยืนยันอีเมลจะแสดงที่ console + หน้าเว็บ (ยังไม่ส่ง SMS/อีเมลจริง)
# false = โหมดจริง: ต้องมี service SMS/อีเมลจริง (ดู otp.js และ mailer.js)
DEV_MODE=true

# ============ OTP ============
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ============ ฐานข้อมูล ============
DB_PATH=shop.db

# ============ Google reCAPTCHA v2 ============
# ใส่ key เมื่อต้องการเปิดใช้งาน (ได้จาก https://www.google.com/recaptcha/admin)
# ถ้าว่างไว้ ระบบจะข้าม reCAPTCHA และใช้ honeypot + rate limit แทน (สำหรับ dev)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ============ SMS (OTP จริง) — ไม่บังคับในโหมด dev ============
# 2 ทางเลือก (เลือก provider ได้ที่หน้าแอดมิน /admin/otp.html หรือที่นี่):
# 1) Twilio — https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
# 2) ThaiBulkSMS (API v2) — https://www.thaibulksms.com (เหมาะกับ SMS ไทย)
TBS_API_KEY=
TBS_API_SECRET=
TBS_SENDER=

# ============ SMTP (อีเมลจริง) — ไม่บังคับในโหมด dev ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============ Google OAuth (เข้าสู่ระบบด้วย Google) ============
# ว่างไว้ = โหมดทดสอบ (dev): กดปุ่ม Google จะไปหน้า mock ให้กรอกอีเมลจำลอง
# มีค่า = OAuth จริง (สร้างได้ที่ https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
